window-rule {
    match app-id=r"^org\.hoopoo\.[^.]+$"
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 610; }
}
window-rule {
    match app-id="org.hoopoo.about"
    open-floating true
    default-column-width { fixed 1070; }
    default-window-height { fixed 610; }
}
window-rule {
    match app-id="at.yrlf.wl_mirror"
    open-focused false
}
window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
}

