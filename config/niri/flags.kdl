// Toggle flags — managed by hoopoo scripts, do not edit manually.
// Each file is optional: if it doesn't exist, it is silently skipped.
// Scripts write KDL snippets here to toggle features on/off persistently.

include optional=true "~/.local/state/hoopoo/toggles/niri/touchpad-disabled.kdl"
include optional=true "~/.local/state/hoopoo/toggles/niri/touchscreen-disabled.kdl"
include optional=true "~/.local/state/hoopoo/toggles/niri/gaps-enabled.kdl"
include optional=true "~/.local/state/hoopoo/toggles/niri/transparency-disabled.kdl"
include optional=true "~/.local/state/hoopoo/toggles/niri/wl-mirror-output.kdl"
