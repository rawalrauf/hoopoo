#!/bin/bash

# hoopoo:summary=Update Hoopoo and system packages
# hoopoo:args=[-y]
# hoopoo:examples=hoopoo update | hoopoo update -y
# hoopoo:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $HOOPOO_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env HOOPOO_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/hoopoo-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://github.com/rawalrauf/hoopoo/discussions/categories/general\033[0m"' ERR

if [[ $1 == "-y" ]] || hoopoo-update-confirm; then
  hoopoo-snapshot create || (($? == 127))
  hoopoo-update-git
  hoopoo-update-perform
fi
