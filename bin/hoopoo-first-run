#!/bin/bash

# hoopoo:summary=Finish the installation of Hoopoo with items that can only be done after logging in.
# hoopoo:requires-sudo=true

set -e

FIRST_RUN_MODE=~/.local/state/hoopoo/first-run.mode

if [[ -f $FIRST_RUN_MODE ]]; then
  rm -f "$FIRST_RUN_MODE"

  bash "$HOOPOO_PATH/install/first-run/battery-monitor.sh"
  bash "$HOOPOO_PATH/install/first-run/recover-internal-monitor.sh"
  bash "$HOOPOO_PATH/install/first-run/cleanup-reboot-sudoers.sh"
  bash "$HOOPOO_PATH/install/first-run/firewall.sh"
  bash "$HOOPOO_PATH/install/first-run/dns-resolver.sh"
  bash "$HOOPOO_PATH/install/first-run/gnome-theme.sh"
  bash "$HOOPOO_PATH/install/first-run/swayosd.sh"
  bash "$HOOPOO_PATH/install/first-run/gtk-primary-paste.sh"
  bash "$HOOPOO_PATH/install/first-run/elephant.sh"
  bash "$HOOPOO_PATH/install/first-run/fcitx5.sh"
  hoopoo-hook-install post-update "$HOOPOO_PATH/install/first-run/install-voxtype.hook"
  sudo rm -f /etc/sudoers.d/first-run

  bash "$HOOPOO_PATH/install/first-run/welcome.sh"
  bash "$HOOPOO_PATH/install/first-run/wifi.sh"
fi
