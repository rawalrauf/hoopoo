#!/bin/bash

# omarchy:summary=Check which omarchy mirror packages are referenced in the repo
# omarchy:group=dev

REPO_DIR="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
OMARCHY_DB_URL="https://pkgs.omarchy.org/stable/x86_64/omarchy.db"
HOOPOO_RELEASE_URL="https://github.com/rawalrauf/hoopoo-pkgs/releases/download/stable/hoopoo.db"

echo "Fetching omarchy package list..."
omarchy_pkgs=$(curl -s "$OMARCHY_DB_URL" | zstd -d 2>/dev/null | tar -t 2>/dev/null | grep "/$" | sed 's|/||' | sed 's|-[^-]*-[^-]*$||' | sort -u)

echo "Fetching hoopoo package list..."
hoopoo_pkgs=$(curl -sL "$HOOPOO_RELEASE_URL" | zstd -d 2>/dev/null | tar -t 2>/dev/null | grep "/$" | sed 's|/||' | sed 's|-[^-]*-[^-]*$||' | sort -u)

echo ""
printf "%-40s %-10s %-12s %s\n" "PACKAGE" "IN_HOOPOO" "IN_OFFICIAL" "REFERENCED_IN"
echo "$(printf '%.0s-' {1..120})"

while IFS= read -r pkg; do
  [[ -z $pkg ]] && continue

  in_hoopoo=$(echo "$hoopoo_pkgs" | grep -c "^${pkg}$" 2>/dev/null)
  in_official=$(pacman -Si "$pkg" 2>/dev/null | grep "^Repository" | grep -vc "omarchy\|hoopoo" 2>/dev/null)

  refs=$(grep -rl "\b${pkg}\b" "$REPO_DIR" \
    --include="*.sh" --include="*.packages" --include="*.kdl" \
    --include="*.conf" --include="*.toml" --include="*.yml" \
    2>/dev/null | grep -v ".git/" | sed "s|$REPO_DIR/||" | tr '\n' ',' | sed 's/,$//')

  [[ -z $refs ]] && continue

  [[ "$in_hoopoo" -gt 0 ]] && hoopoo_str="yes" || hoopoo_str="NO"
  [[ "$in_official" -gt 0 ]] && official_str="yes" || official_str="NO"

  printf "%-40s %-10s %-12s %s\n" "$pkg" "$hoopoo_str" "$official_str" "$refs"
done <<< "$omarchy_pkgs"
