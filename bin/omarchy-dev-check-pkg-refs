#!/bin/bash

# omarchy:summary=Check which omarchy mirror packages are referenced in the repo
# omarchy:group=dev

REPO_DIR="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
OMARCHY_DB_URL="https://pkgs.omarchy.org/stable/x86_64/omarchy.db"
HOOPOO_DB_URL="https://github.com/rawalrauf/hoopoo-pkgs/releases/download/stable/hoopoo.db"

echo "Fetching omarchy package list..."
omarchy_pkgs=$(curl -s "$OMARCHY_DB_URL" | zstd -d 2>/dev/null | tar -t 2>/dev/null | grep "/$" | sed 's|/||' | sed 's|-[^-]*-[^-]*$||' | sort -u)

echo "Fetching hoopoo package list..."
hoopoo_pkgs=$(curl -s "$HOOPOO_DB_URL" | zstd -d 2>/dev/null | tar -t 2>/dev/null | grep "/$" | sed 's|/||' | sed 's|-[^-]*-[^-]*$||' | sort -u)

echo ""
printf "%-40s %-10s %-10s %s\n" "PACKAGE" "IN_HOOPOO" "IN_OFFICIAL" "REFERENCED_IN"

while IFS= read -r pkg; do
  [[ -z $pkg ]] && continue

  in_hoopoo=$(echo "$hoopoo_pkgs" | grep -c "^${pkg}$" 2>/dev/null || echo 0)
  in_official=$(pacman -Si "$pkg" 2>/dev/null | grep "^Repository" | grep -cv "omarchy\|hoopoo" 2>/dev/null || echo 0)

  refs=$(grep -rl "\b${pkg}\b" "$REPO_DIR" \
    --include="*.sh" --include="*.packages" --include="*.kdl" \
    --include="*.conf" --include="*.toml" --include="*.yml" \
    2>/dev/null | grep -v ".git/" | sed "s|$REPO_DIR/||" | tr '\n' ',' | sed 's/,$//')

  [[ -z $refs ]] && continue

  in_hoopoo_str=$([[ $in_hoopoo -gt 0 ]] && echo "yes" || echo "NO")
  in_official_str=$([[ $in_official -gt 0 ]] && echo "yes" || echo "NO")

  printf "%-40s %-10s %-10s %s\n" "$pkg" "$in_hoopoo_str" "$in_official_str" "$refs"
done <<< "$omarchy_pkgs"
