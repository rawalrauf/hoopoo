#!/bin/bash

# hoopoo:summary=Set the Hoopoo channel, which dictates what git branch and package repository is used.
# hoopoo:args=<stable|dev>
# hoopoo:requires-sudo=true

if (($# == 0)); then
  echo "Usage: hoopoo-channel-set [stable|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") hoopoo-branch-set "master" && hoopoo-refresh-pacman "stable" ;;
"dev") hoopoo-branch-set "dev" && hoopoo-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

hoopoo-update -y
