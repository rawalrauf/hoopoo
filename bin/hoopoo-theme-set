#!/bin/bash

# hoopoo:summary=Apply an Hoopoo theme
# hoopoo:args=<theme-name>
# hoopoo:examples=hoopoo theme list | hoopoo theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: hoopoo-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/hoopoo/current/theme"
NEXT_THEME_PATH="$HOME/.config/hoopoo/current/next-theme"
USER_THEMES_PATH="$HOME/.config/hoopoo/themes"
HOOPOO_THEMES_PATH="$HOOPOO_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $HOOPOO_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$HOOPOO_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  hoopoo-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
hoopoo-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/hoopoo/current/theme.name"

# Change background with theme
if [[ $HOOPOO_THEME_SKIP_BACKGROUND != "1" ]]; then
  hoopoo-theme-bg-next
fi

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  hoopoo-restart-waybar
fi
hoopoo-restart-niri
hoopoo-restart-swayosd
hoopoo-restart-terminal
hoopoo-restart-btop
hoopoo-restart-opencode
hoopoo-restart-mako
hoopoo-restart-helix

# Change app-specific themes
hoopoo-theme-set-foot
hoopoo-theme-set-gnome
hoopoo-theme-set-browser
hoopoo-theme-set-vscode
hoopoo-theme-set-obsidian
hoopoo-theme-set-keyboard

# Call hook on theme set
hoopoo-hook theme-set "$THEME_NAME" >/dev/null
