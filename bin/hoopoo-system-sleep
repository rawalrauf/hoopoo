#!/bin/bash

# hoopoo:summary=Turn off keyboard backlight and lock the screen before system sleep
# hoopoo:group=system
# hoopoo:name=sleep
# hoopoo:examples=hoopoo system sleep

hoopoo-brightness-keyboard off

if [[ -f /tmp/hoopoo-hibernating ]]; then
  rm -f /tmp/hoopoo-hibernating
else
  HOOPOO_LOCK_ONLY=true hoopoo-system-lock
fi
