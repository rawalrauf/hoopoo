#!/bin/bash

# hoopoo:summary=Restore the default Hoopoo Plymouth boot theme and SDDM login screen
# hoopoo:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/hoopoo"

sudo find ~/.local/share/hoopoo/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme hoopoo

if hoopoo-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

hoopoo-refresh-sddm
