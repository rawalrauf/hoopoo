#!/bin/bash

# hoopoo:summary=Enable, disable, or toggle the touch functionality of the screen
# hoopoo:args=[on|off|toggle]

STATE_FILE="$HOME/.local/state/hoopoo/toggles/niri/touchscreen-disabled.kdl"

enable() {
  rm -f "$STATE_FILE"
  hoopoo-restart-niri
  hoopoo-swayosd-client --custom-icon device-support-touch-symbolic --custom-message "Touchscreen enabled"
}

disable() {
  mkdir -p "$(dirname "$STATE_FILE")"
  printf 'input {\n    touch {\n        off\n    }\n}\n' > "$STATE_FILE"
  hoopoo-restart-niri
  hoopoo-swayosd-client --custom-icon touch-disabled-symbolic --custom-message "Touchscreen disabled"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) hoopoo-niri-toggle-enabled touchscreen-disabled && enable || disable ;;
esac
