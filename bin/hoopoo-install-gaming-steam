#!/bin/bash

# hoopoo:summary=Install Steam and graphics drivers selected for this system
# hoopoo:requires-sudo=true

set -e

echo "Installing Steam..."
hoopoo-pkg-add steam
hoopoo-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
