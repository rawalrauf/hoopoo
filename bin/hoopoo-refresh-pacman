#!/bin/bash

# hoopoo:summary=Overwrite the package configuration for /etc/pacman with the Hoopoo default of using its dedicated mirrors and repositories, then update all packages.
# hoopoo:requires-sudo=true

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak

channel="${1:-stable}"

if [[ $channel != "stable" && $channel != "edge" ]]; then
  echo "Error: Invalid channel '$channel'. Must be one of: stable, edge"
  exit 1
fi

echo "Setting channel to $channel"
echo

sudo cp -f "$HOOPOO_PATH/default/pacman/pacman-$channel.conf" /etc/pacman.conf

# Reset all package DBs and then update
sudo pacman -Syyuu --noconfirm
