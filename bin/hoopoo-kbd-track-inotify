#!/bin/bash

# hoopoo:summary=Track keyboard backlight changes via inotify (event-driven).
# hoopoo:hidden=true

# This tracker uses inotify on hardware-provided brightness_hw_changed file
# for event-driven updates. No polling needed - zero CPU usage when idle.
# Works on ThinkPads and any other laptop with hw_changed support.

# Find the keyboard backlight brightness file. Most hardware exposes it as a
# led under /sys/class/leds; a few vendors only expose it as a backlight
# device under /sys/class/backlight.
brightness_file=""
for class in leds backlight; do
  for candidate in /sys/class/$class/*kbd_backlight*; do
    if [[ -e $candidate ]]; then
      brightness_file="$candidate/brightness"
      break 2
    fi
  done
done

# Find hw_changed file (flexible pattern to cover all vendors)
hw_changed_file=""
for candidate in \
  /sys/devices/platform/*/leds/*kbd_backlight*/brightness_hw_changed \
  /sys/devices/platform/*/backlight/*kbd_backlight*/brightness_hw_changed \
  /sys/class/leds/*kbd_backlight*/brightness_hw_changed \
  /sys/class/backlight/*kbd_backlight*/brightness_hw_changed; do
  if [[ -f $candidate ]]; then
    hw_changed_file="$candidate"
    break
  fi
done

[[ -z $brightness_file || -z $hw_changed_file ]] && exit 1

state_file="${XDG_RUNTIME_DIR:-/run/user/$UID}/hoopoo/kbd-brightness-tracker"

mkdir -p "$(dirname "$state_file")"

# Save current brightness (no zero filtering - testing if inotify triggers on lid close)
save_brightness() {
  current="$(cat "$brightness_file")"
  [[ -z $current ]] && return
  echo "$current" > "$state_file"
}

# Save initial value on login.
save_brightness

# Event-driven loop using inotify. Wakes only when brightness changes.
last_value="$(cat "$state_file" 2>/dev/null)"
inotifywait -m -e modify "$hw_changed_file" 2>/dev/null | while read event; do
  current="$(cat "$brightness_file")"
  [[ -z $current || $current == $last_value ]] && continue
  last_value=$current
  echo "$current" > "$state_file"
done
