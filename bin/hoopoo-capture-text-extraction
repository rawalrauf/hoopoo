#!/bin/bash

# hoopoo:summary=Extract text from a screenshot region with OCR
# hoopoo:group=capture
# hoopoo:examples=hoopoo capture ocr

SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${HOOPOO_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1

[[ -z $TEXT ]] && exit 1

printf "%s" "$TEXT" | wl-copy
hoopoo-notification-send "󰴑" "Copied text from selection to clipboard"
