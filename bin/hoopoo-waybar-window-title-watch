#!/bin/bash

# hoopoo:summary=Watch niri window focus events and hide the active window title in waybar when focus is lost
# hoopoo:hidden=true

trap '' RTMIN+9

niri msg event-stream 2>/dev/null | while IFS= read -r line; do
  if [[ $line == *"Overview toggled: true"* || $line == *"Window focus changed: None"* ]]; then
    grep -qF '#window label { font-size: 0; }' "$HOME/.config/waybar/style.css" || \
      printf '#window label { font-size: 0; }\n' >> "$HOME/.config/waybar/style.css"
    while IFS= read -r inner; do
      if [[ $inner == *"Overview toggled: false"* || $inner == *"Window focus changed: Some"* ]]; then
        truncate -s -$(wc -c < <(printf '#window label { font-size: 0; }\n')) "$HOME/.config/waybar/style.css"
        break
      fi
    done
  fi
done
