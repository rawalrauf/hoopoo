#!/bin/bash

# hoopoo:summary=Ensure all default .desktop, web apps, TUIs, and npx wrappers are installed.

mkdir -p ~/.local/share/icons/hicolor/512x512@2/apps/

for icon in ~/.local/share/hoopoo/applications/icons/*.png; do
  cp "$icon" ~/.local/share/icons/hicolor/512x512@2/apps/
  gtk-update-icon-cache -f -t ~/.local/share/icons/hicolor &>/dev/null
done

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp ~/.local/share/hoopoo/applications/*.desktop ~/.local/share/applications/
cp ~/.local/share/hoopoo/applications/hidden/*.desktop ~/.local/share/applications/

if hoopoo-cmd-present foot; then
  cp ~/.local/share/hoopoo/default/foot/foot.desktop ~/.local/share/applications/
  hoopoo-default-terminal foot
fi

# Refresh the webapps, TUIs, and npx wrappers
bash $HOOPOO_PATH/install/packaging/icons.sh
bash $HOOPOO_PATH/install/packaging/webapps.sh
bash $HOOPOO_PATH/install/packaging/tuis.sh
bash $HOOPOO_PATH/install/packaging/npx.sh

update-desktop-database ~/.local/share/applications
