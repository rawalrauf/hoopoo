#!/bin/bash

# hoopoo:summary=Reinstall Hoopoo packages and reset default configs
# hoopoo:requires-sudo=true

set -e

# Attempt to reinstall all default Hoopoo packages and reset all the default configs.

echo -e "This will reinstall all the default Hoopoo packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  hoopoo-reinstall-git
  hoopoo-reinstall-pkgs
  hoopoo-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && hoopoo-system-reboot
fi
