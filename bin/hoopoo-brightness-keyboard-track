#!/bin/bash

# hoopoo:summary=Track firmware keyboard backlight changes into persistent state.
# hoopoo:hidden=true

# Find the keyboard backlight brightness file. Most hardware exposes it as a
# led under /sys/class/leds; a few vendors only expose it as a backlight
# device under /sys/class/backlight.
brightness_file=""
for class in leds backlight; do
  for candidate in /sys/class/$class/*kbd_backlight*; do
    if [[ -e $candidate ]]; then
      brightness_file="$candidate/brightness"
      break 2
    fi
  done
done

[[ -z $brightness_file ]] && exit 0

state_file="$HOME/.local/state/hoopoo/kbd-brightness"

mkdir -p "$(dirname "$state_file")"

# Read current brightness, save if non-zero.
save_brightness() {
  current="$(cat "$brightness_file")"
  [[ -z $current ]] && return
  (( current == 0 )) && return
  echo "$current" > "$state_file"
}

# Save initial value on login.
save_brightness

# Poll loop. inotify doesn't work on sysfs, but hw_changed and brightness
# update reliably when firmware changes the backlight, so polling is cheap
# and catches every change - keybinds, firmware keys, brightnessctl.
last_value="$(cat "$state_file" 2>/dev/null)"
while sleep 0.5; do
  current="$(cat "$brightness_file")"
  [[ -z $current ]] && continue
  (( current == 0 )) && continue
  (( current == last_value )) && continue
  last_value=$current
  echo "$current" > "$state_file"
done
