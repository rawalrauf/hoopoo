#!/bin/bash

# hoopoo:summary=Reinstall all default Hoopoo packages from the stable channel
# hoopoo:requires-sudo=true

set -e

# Reinstall all default Hoopoo packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
hoopoo-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$HOOPOO_PATH/install/hoopoo-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
