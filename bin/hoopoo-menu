#!/bin/bash

# hoopoo:summary=Launch the Hoopoo Menu or takes a parameter to jump straight to a submenu.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | hoopoo-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.hoopoo.terminal "$@"
}

present_terminal() {
  hoopoo-launch-floating-terminal-with-presentation $1
}

open_in_editor() {
  notify-send -u low "󰈙  Editing config file" "$1"
  hoopoo-launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; hoopoo-pkg-add $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; hoopoo-pkg-add $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; hoopoo-pkg-add $2 && sleep 2 && hoopoo-font-set '$3'"
}

install_terminal() {
  present_terminal "hoopoo-install-terminal $1"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; hoopoo-pkg-aur-add $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; hoopoo-pkg-aur-add $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Hoopoo\n  Niri\n󰣇  Arch\n  Neovim\n󱆃  Bash") in
  *Keybindings*) hoopoo-menu-keybindings ;;
  *Hoopoo*) hoopoo-launch-webapp "https://github.com/rawalrauf/hoopoo" ;;
  *Niri*) hoopoo-launch-webapp "https://niri-wm.github.io/niri/index.html" ;;
  *Arch*) hoopoo-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) hoopoo-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) hoopoo-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n  Toggle\n  Hardware") in
  *Reminder*) show_reminder_menu ;;
  *Capture*) show_capture_menu ;;
  *Transcode*) hoopoo-transcode || back_to show_trigger_menu ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) hoopoo-reminder show ;;
  *"Clear all"*) hoopoo-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(hoopoo-menu-input "Remind in minutes")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    hoopoo-notification-send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(hoopoo-menu-input "Reminder message")

  if [[ -n $message ]]; then
    hoopoo-reminder "$minutes" "$message"
  else
    hoopoo-reminder "$minutes"
  fi
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in
  *Screenshot*) show_screenshot_menu ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) hoopoo-capture-text-extraction ;;
  *Color*) hoopoo-capture-color ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_screenshot_menu() {
  case $(menu "Screenshot" "󰩭  Select Region\n  Full Screen\n  Active Window") in
  *"Select Region"*) hoopoo-capture-screenshot ;;
  *"Full Screen"*) hoopoo-capture-screenshot fullscreen ;;
  *"Active Window"*) hoopoo-capture-screenshot window ;;
  *) back_to show_capture_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "󰀦  No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

show_screenrecord_menu() {
  hoopoo-capture-screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio") hoopoo-capture-screenrecording >/dev/null ;;
  *"With desktop audio") hoopoo-capture-screenrecording --with-desktop-audio >/dev/null ;;
  *"With desktop + microphone audio") hoopoo-capture-screenrecording --with-desktop-audio --with-microphone-audio >/dev/null ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    hoopoo-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device" >/dev/null
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) hoopoo-menu-share clipboard ;;
  *File*) terminal bash -c "hoopoo-menu-share file" ;;
  *Folder*) terminal bash -c "hoopoo-menu-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  local idle="󱫖  Idle Lock"
  local notifications="󰂛  Notifications"
  local bar="󰍜  Top Bar"
  local gaps="  Window Gaps"
  local transparency="󰂵  Window Transparency"
  local directboot="  Direct Boot"

  pgrep -x swayidle >/dev/null && idle="$idle ✓"
  ! makoctl mode | grep -q 'do-not-disturb' && notifications="$notifications ✓"
  pgrep -x waybar >/dev/null && bar="$bar ✓"
  hoopoo-niri-toggle-enabled gaps-enabled && gaps="$gaps ✓"
  ! hoopoo-niri-toggle-enabled transparency-disabled && transparency="$transparency ✓"
  local sudopasswordless="󰟵  Passwordless Sudo"
  hoopoo-toggle-enabled direct-boot-enabled && directboot="$directboot ✓"
  [[ -f "/tmp/hoopoo-sudo-passwordless-${USER}" ]] && sudopasswordless="$sudopasswordless ✓"

  local options="$idle\n$notifications\n$bar\n$gaps\n$transparency\n󰍹  Monitor Scaling\n$directboot\n$sudopasswordless"

  case $(menu "Toggle" "$options") in
  *Idle*) hoopoo-toggle-idle ;;
  *Notifications*) hoopoo-toggle-notification-silencing ;;
  *"Top Bar"*) hoopoo-toggle-waybar ;;
  *Gaps*) hoopoo-niri-window-gaps-toggle ;;
  *Transparency*) hoopoo-niri-window-transparency-toggle ;;
  *Scaling*) show_monitor_scaling_menu ;;
  *"Direct Boot"*) present_terminal hoopoo-config-direct-boot ;;
  *"Passwordless Sudo"*) present_terminal hoopoo-sudo-passwordless ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_monitor_scaling_menu() {
  local current
  current=$(niri msg outputs 2>/dev/null | grep "Scale:" | awk '{print $2}' | head -1)
  local scale
  scale=$(hoopoo-menu-select "Monitor Scale" --current "$current" "1" "1.25" "1.5" "2") || back_to show_toggle_menu
  [[ -n $scale ]] && hoopoo-niri-monitor-scaling-cycle --set "$scale"
}

show_hardware_menu() {
  local options="󰛧  Laptop Display\n 󰍹  Mirror Display"

  if hoopoo-hw-hybrid-gpu; then
    options="$options\n  Hybrid GPU"
  fi

  if hoopoo-hw-touchpad; then
    options="$options\n󰟸  Touchpad"
  fi

  if hoopoo-hw-dell-xps-haptic-touchpad && hoopoo-cmd-present dell-xps-touchpad-haptics; then
    options="$options\n󰌌  Touchpad Haptics"
  fi

  if hoopoo-hw-touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Toggle" "$options") in
  *Laptop*) hoopoo-niri-monitor-internal toggle ;;
  *Mirror*) hoopoo-niri-monitor-internal-mirror toggle ;;
  *Haptics*) show_hardware_touchpad_haptics_menu ;;
  *Touchpad*) hoopoo-toggle-touchpad ;;
  *Touchscreen*) hoopoo-toggle-touchscreen ;;
  *"Hybrid GPU"*) present_terminal hoopoo-toggle-hybrid-gpu ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_touchpad_haptics_menu() {
  local current=$(dell-xps-touchpad-haptics get)
  local selected=$(menu "Touchpad Haptics" "low\nmid\nhigh" "" "$current")

  if [[ -n $selected ]]; then
    dell-xps-touchpad-haptics set "$selected"
  else
    back_to show_hardware_menu
  fi
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n󰟵  Unlock\n  Font\n  Background\n  Niri\n  About") in
  *Theme*) show_theme_menu ;;
  *Unlock*) hoopoo-launch-walker -m menus:hoopoounlocks --width 800 --minheight 400 ;;
  *Font*) show_font_menu ;;
  *Background*) show_background_menu ;;
  *Niri*) open_in_editor ~/.config/niri/looknfeel.kdl ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) hoopoo-branding-about text ;;
  *Image*) hoopoo-branding-about image ;;
  *Default*) hoopoo-branding-about reset ;;
  *) show_style_menu ;;
  esac
}


show_theme_menu() {
  hoopoo-launch-walker -m menus:hoopoothemes --width 800 --minheight 400
}

show_background_menu() {
  hoopoo-launch-walker -m menus:hoopooBackgroundSelector --width 800 --minheight 400
}

show_font_menu() {
  local current
  current=$(hoopoo-font-current)
  local fonts
  mapfile -t fonts < <(hoopoo-font-list)
  local theme
  theme=$(hoopoo-menu-select "Font" --current "$current" "${fonts[@]}" -- --width 350) || back_to show_style_menu
  [[ -n $theme ]] && hoopoo-font-set "$theme"
}

show_setup_menu() {
  local options="  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n  System Sleep\n󰍹  Monitors"
  [[ -f ~/.config/niri/bindings.kdl ]] && options="$options\n  Keybindings"
  [[ -f ~/.config/niri/input.kdl ]] && options="$options\n  Input"
  options="$options\n  Defaults\n󰱔  DNS\n  Security\n  Config"

  case $(menu "Setup" "$options") in
  *Audio*) hoopoo-launch-audio ;;
  *Wifi*) hoopoo-launch-wifi ;;
  *Bluetooth*) hoopoo-launch-bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *System*) show_setup_system_menu ;;
  *Monitors*) open_in_editor ~/.config/niri/monitors.kdl ;;
  *Keybindings*) open_in_editor ~/.config/niri/bindings.kdl ;;
  *Input*) open_in_editor ~/.config/niri/input.kdl ;;
  *Defaults*) show_setup_default_menu ;;
  *DNS*) present_terminal hoopoo-setup-dns ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  local current profile
  current=$(powerprofilesctl get)
  profile=$(hoopoo-menu-select "Power Profile" --current "$current" $(hoopoo-powerprofiles-list | tr '\n' ' '))
  [[ -z $profile ]] && back_to show_setup_menu
  powerprofilesctl set "$profile"
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_terminal hoopoo-setup-security-fingerprint ;;
  *Fido2*) present_terminal hoopoo-setup-security-fido2 ;;
  *) show_setup_menu ;;
  esac
}

show_setup_default_menu() {
  case $(menu "Default" "  Browser\n  Terminal\n  Editor") in
  *Browser*) show_setup_default_browser_menu ;;
  *Terminal*) show_setup_default_terminal_menu ;;
  *Editor*) show_setup_default_editor_menu ;;
  *) show_setup_menu ;;
  esac
}

browser_desktop_exists() {
  [[ -f ~/.local/share/applications/$1 || -f ~/.nix-profile/share/applications/$1 || -f /usr/share/applications/$1 ]]
}


show_setup_default_browser_menu() {
  local options=()
  browser_desktop_exists chromium.desktop && options+=("  Chromium")
  browser_desktop_exists google-chrome.desktop && options+=("󰊯  Chrome")
  browser_desktop_exists brave-browser.desktop && options+=("󰖟  Brave")
  browser_desktop_exists brave-origin-beta.desktop && options+=("󰖟  Brave Origin")
  browser_desktop_exists microsoft-edge.desktop && options+=("󰇩  Edge")
  browser_desktop_exists firefox.desktop && options+=("󰈹  Firefox")
  browser_desktop_exists zen.desktop && options+=("󰖟  Zen")
  browser_desktop_exists vivaldi-stable.desktop && options+=("󰖟  Vivaldi")

  local current=""
  case "$(hoopoo-default-browser)" in
  chromium) current="  Chromium" ;;
  chrome) current="󰊯  Chrome" ;;
  brave) current="󰖟  Brave" ;;
  brave-origin) current="󰖟  Brave Origin" ;;
  edge) current="󰇩  Edge" ;;
  firefox) current="󰈹  Firefox" ;;
  zen) current="󰖟  Zen" ;;
  vivaldi) current="󰖟  Vivaldi" ;;
  esac

  local choice
  choice=$(hoopoo-menu-select "Default Browser" --current "$current" "${options[@]}") || back_to show_setup_default_menu
  case "$choice" in
  *Chromium*) hoopoo-default-browser chromium ;;
  *Chrome*) hoopoo-default-browser chrome ;;
  *"Brave Origin"*) hoopoo-default-browser brave-origin ;;
  *Brave*) hoopoo-default-browser brave ;;
  *Edge*) hoopoo-default-browser edge ;;
  *Firefox*) hoopoo-default-browser firefox ;;
  *Zen*) hoopoo-default-browser zen ;;
  *Vivaldi*) hoopoo-default-browser vivaldi ;;
  esac
}

show_setup_default_terminal_menu() {
  local options=()
  hoopoo-cmd-present alacritty && options+=("  Alacritty")
  hoopoo-cmd-present foot && options+=("  Foot")
  hoopoo-cmd-present ghostty && options+=("  Ghostty")
  hoopoo-cmd-present kitty && options+=("  Kitty")

  local current=""
  case "$(hoopoo-default-terminal)" in
  alacritty) current="  Alacritty" ;;
  foot) current="  Foot" ;;
  ghostty) current="  Ghostty" ;;
  kitty) current="  Kitty" ;;
  esac

  local choice
  choice=$(hoopoo-menu-select "Default Terminal" --current "$current" "${options[@]}") || back_to show_setup_default_menu
  case "$choice" in
  *Alacritty*) hoopoo-default-terminal alacritty ;;
  *Foot*) hoopoo-default-terminal foot ;;
  *Ghostty*) hoopoo-default-terminal ghostty ;;
  *Kitty*) hoopoo-default-terminal kitty ;;
  esac
}

show_setup_default_editor_menu() {
  local options=()
  hoopoo-cmd-present nvim && options+=("  Neovim")
  hoopoo-cmd-present code && options+=("  VSCode")
  hoopoo-cmd-present cursor && options+=("  Cursor")
  hoopoo-cmd-present zeditor && options+=("  Zed")
  hoopoo-cmd-present sublime_text && options+=("  Sublime Text")
  hoopoo-cmd-present helix && options+=("  Helix")
  hoopoo-cmd-present vim && options+=("  Vim")
  hoopoo-cmd-present emacs && options+=("  Emacs")

  local current=""
  case "$(hoopoo-default-editor)" in
  nvim) current="  Neovim" ;;
  code) current="  VSCode" ;;
  cursor) current="  Cursor" ;;
  zed | zeditor) current="  Zed" ;;
  sublime_text) current="  Sublime Text" ;;
  helix) current="  Helix" ;;
  vim) current="  Vim" ;;
  emacs) current="  Emacs" ;;
  esac

  local choice
  choice=$(hoopoo-menu-select "Default Editor" --current "$current" "${options[@]}") || back_to show_setup_default_menu
  case "$choice" in
  *Neovim*) hoopoo-default-editor nvim ;;
  *VSCode*) hoopoo-default-editor code ;;
  *Cursor*) hoopoo-default-editor cursor ;;
  *Zed*) hoopoo-default-editor zed ;;
  *Sublime*) hoopoo-default-editor sublime_text ;;
  *Helix*) hoopoo-default-editor helix ;;
  *Vim*) hoopoo-default-editor vim ;;
  *Emacs*) hoopoo-default-editor emacs ;;
  esac
}


show_setup_config_menu() {
  case $(menu "Setup" "  Niri\n  Swayidle\n  Hyprlock\n  Swayosd\n󰌧  Walker\n󰍜  Waybar\n󰞅  Compose Shortcuts") in
  *Niri*) open_in_editor ~/.config/niri/config.kdl && hoopoo-restart-niri ;;
  *Swayidle*) open_in_editor ~/.config/swayidle/swayidle.conf && hoopoo-restart-swayidle ;;
  *Hyprlock*) open_in_editor ~/.config/hypr/hyprlock.conf && pkill -x hyprlock || true ;;
  *Swayosd*) open_in_editor ~/.config/swayosd/config.toml && hoopoo-restart-swayosd ;;
  *Walker*) open_in_editor ~/.config/walker/config.toml && hoopoo-restart-walker ;;
  *Waybar*) open_in_editor ~/.config/waybar/config.jsonc && hoopoo-restart-waybar ;;
  *Compose*) open_in_editor ~/.XCompose && hoopoo-restart-xcompose ;;
  *) show_setup_menu ;;
  esac
}

show_setup_system_menu() {
  local options=""

  if hoopoo-toggle-enabled suspend-off; then
    options="$options󰒲  Enable Suspend"
  else
    options="$options󰒲  Disable Suspend"
  fi

  if hoopoo-hibernation-available; then
    options="$options\n󰤁  Disable Hibernate"
  else
    options="$options\n󰤁  Enable Hibernate"
  fi

  case $(menu "System" "$options") in
  *Suspend*) hoopoo-toggle-suspend ;;
  *"Enable Hibernate"*) present_terminal hoopoo-hibernation-setup ;;
  *"Disable Hibernate"*) present_terminal hoopoo-hibernation-remove ;;
  *) show_setup_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n  Web App\n  TUI\n  Service\n  Style\n󰵮  Development\n  Editor\n  Terminal\n  Browser\n󱚤  AI\n  Gaming\n󰍲  Windows") in
  *Package*) terminal hoopoo-pkg-install ;;
  *AUR*) terminal hoopoo-pkg-aur-install ;;
  *Web*) present_terminal hoopoo-webapp-install ;;
  *TUI*) present_terminal hoopoo-tui-install ;;
  *Service*) show_install_service_menu ;;
  *Style*) show_install_style_menu ;;
  *Development*) show_install_development_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Terminal*) show_install_terminal_menu ;;
  *Browser*) show_install_browser_menu ;;
  *Gaming*) show_install_gaming_menu ;;
  *AI*) show_install_ai_menu ;;
  *Windows*) present_terminal "hoopoo-windows-vm install" ;;
  *) show_main_menu ;;
  esac
}

show_install_browser_menu() {
  case $(menu "Install" "  Chrome\n  Edge\n  Brave\n  Brave Origin\n  Firefox\n󰖟  Zen") in
  *Chrome*) present_terminal "hoopoo-install-browser chrome" ;;
  *Edge*) present_terminal "hoopoo-install-browser edge" ;;
  *"Brave Origin"*) present_terminal "hoopoo-install-browser brave-origin" ;;
  *Brave*) present_terminal "hoopoo-install-browser brave" ;;
  *Firefox*) present_terminal "hoopoo-install-browser firefox" ;;
  *Zen*) present_terminal "hoopoo-install-browser zen" ;;
  *) show_install_menu ;;
  esac
}

show_install_service_menu() {
  case $(menu "Install" "  Dropbox\n  Tailscale\n󱇱  NordVPN [AUR]\n󰏖  ONCE\n󰟵  Bitwarden\n  Chromium Account") in
  *Dropbox*) present_terminal hoopoo-install-dropbox ;;
  *Tailscale*) present_terminal hoopoo-install-tailscale ;;
  *NordVPN*) present_terminal hoopoo-install-nordvpn ;;
  *ONCE*) present_terminal hoopoo-install-once ;;
  *Bitwarden*) install_and_launch "Bitwarden" "bitwarden bitwarden-cli" "bitwarden" ;;
  *Chromium*) present_terminal hoopoo-install-chromium-google-account ;;
  *) show_install_menu ;;
  esac
}

show_install_editor_menu() {
  case $(menu "Install" "  VSCode\n  Cursor\n  Zed\n  Sublime Text\n  Helix\n  Vim\n  Emacs") in
  *VSCode*) present_terminal hoopoo-install-vscode ;;
  *Cursor*) install_and_launch "Cursor" "cursor-bin" "cursor" ;;
  *Zed*) present_terminal hoopoo-install-zed ;;
  *Sublime*) install_and_launch "Sublime Text" "sublime-text-4" "sublime_text" ;;
  *Helix*) present_terminal hoopoo-install-helix ;;
  *Vim*) install "Vim" "vim" ;;
  *Emacs*) install "Emacs" "emacs-wayland" && systemctl --user enable --now emacs.service ;;
  *) show_install_menu ;;
  esac
}

show_install_terminal_menu() {
  case $(menu "Install" "  Alacritty\n  Foot\n  Ghostty\n  Kitty") in
  *Alacritty*) install_terminal "alacritty" ;;
  *Foot*) install_terminal "foot" ;;
  *Ghostty*) install_terminal "ghostty" ;;
  *Kitty*) install_terminal "kitty" ;;
  *) show_install_menu ;;
  esac
}

show_install_ai_menu() {
  ollama_pkg=$(
    (hoopoo-cmd-present nvidia-smi && echo ollama-cuda) ||
      (hoopoo-cmd-present rocminfo && echo ollama-rocm) ||
      echo ollama
  )

  case $(menu "Install" "  Dictation\n󱚤  LM Studio\n󱚤  Ollama\n󱚤  Crush") in
  *Dictation*) present_terminal hoopoo-voxtype-install ;;
  *Studio*) install "LM Studio" "lmstudio-bin" ;;
  *Ollama*) install "Ollama" $ollama_pkg ;;
  *Crush*) install "Crush" "crush-bin" ;;
  *) show_install_menu ;;
  esac
}

