show_update_menu() {
  case $(menu "Update" "  Hoopoo\n󰔫  Channel\n  Config\n󰸌  Extra Themes\n  Process\n󰇅  Hardware\n  Firmware\n  Password\n  Timezone\n  Time") in
  *Hoopoo*) present_terminal hoopoo-update ;;
  *Channel*) show_update_channel_menu ;;
  *Config*) show_update_config_menu ;;
  *Themes*) present_terminal hoopoo-theme-update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Firmware*) present_terminal hoopoo-update-firmware ;;
  *Timezone*) present_terminal hoopoo-tz-select ;;
  *Time*) present_terminal hoopoo-update-time ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_update_channel_menu() {
  local current channel
  current=$(hoopoo-version-channel)
  channel=$(hoopoo-menu-select "Update Channel" --current "$current" stable dev)
  [[ -z $channel ]] && back_to show_update_menu
  present_terminal "hoopoo-channel-set $channel"
}
show_update_process_menu() {
  case $(menu "Restart" "  Niri\n󰎟  Mako\n  Swayosd\n󰌧  Walker\n󰍜  Waybar\n  Swayidle") in
  *Niri*) hoopoo-restart-niri ;;
  *Swayidle*) hoopoo-restart-swayidle ;;
  *Mako*) hoopoo-restart-mako ;;
  *Swayosd*) hoopoo-restart-swayosd ;;
  *Walker*) hoopoo-restart-walker ;;
  *Waybar*) hoopoo-restart-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Niri\n  Swayidle\n  Hyprlock\n󱣴  Plymouth\n  Swayosd\n  Tmux\n󰌧  Walker\n󰍜  Waybar") in
  *Niri*) present_terminal hoopoo-refresh-niri ;;
  *Swayidle*) present_terminal hoopoo-refresh-swayidle ;;
  *Hyprlock*) present_terminal hoopoo-refresh-hyprlock ;;
  *Plymouth*) present_terminal hoopoo-refresh-plymouth ;;
  *Swayosd*) present_terminal hoopoo-refresh-swayosd ;;
  *Tmux*) present_terminal hoopoo-refresh-tmux ;;
  *Walker*) present_terminal hoopoo-refresh-walker ;;
  *Waybar*) present_terminal hoopoo-refresh-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth\n󰟸  Trackpad") in
  *Audio*) present_terminal hoopoo-restart-pipewire ;;
  *Wi-Fi*) present_terminal hoopoo-restart-wifi ;;
  *Bluetooth*) present_terminal hoopoo-restart-bluetooth ;;
  *Trackpad*) present_terminal hoopoo-restart-trackpad ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_terminal hoopoo-drive-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  hoopoo-launch-about
}

show_system_menu() {
  local options="  Lock"
  ! hoopoo-toggle-enabled suspend-off && options="$options\n󰒲  Suspend"
  hoopoo-hibernation-available && options="$options\n󰤁  Hibernate"
  options="$options\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Lock*) hoopoo-system-lock ;;
  *Suspend*) systemctl suspend ;;
  *Hibernate*) hoopoo-system-hibernate ;;
  *Logout*) hoopoo-system-logout ;;
  *Restart*) hoopoo-system-reboot ;;
  *Shutdown*) hoopoo-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) walker -p "Launch…" ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *reminder-set*) show_custom_reminder_input ;;
  *reminder*) show_reminder_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/hoopoo/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
