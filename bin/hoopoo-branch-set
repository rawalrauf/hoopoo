#!/bin/bash

# hoopoo:summary=Set the branch for Hoopoo's git repository.
# hoopoo:args=<main|dev>

if (($# == 0)); then
  echo "Usage: hoopoo-branch-set [main|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "main" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: main, dev"
  exit 1
fi

git -C $HOOPOO_PATH switch $branch
