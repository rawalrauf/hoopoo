#!/bin/bash

# hoopoo:summary=Install one of the approved terminals and set it as the default for Hoopoo (Super + Return etc).
# hoopoo:args=<alacritty|foot|ghostty|kitty>
# hoopoo:requires-sudo=true

if (($# == 0)); then
  echo "Usage: hoopoo-install-terminal [alacritty|foot|ghostty|kitty]"
  exit 1
fi

package="$1"

# Map package name to desktop entry ID
case "$package" in
alacritty) desktop_id="Alacritty.desktop" ;;
foot) desktop_id="foot.desktop" ;;
ghostty) desktop_id="com.mitchellh.ghostty.desktop" ;;
kitty) desktop_id="kitty.desktop" ;;
*)
  echo "Unknown terminal: $package"
  exit 1
  ;;
esac

echo "Installing $package..."

# Install package
if hoopoo-pkg-add $package; then
  # Copy custom desktop entries with X-TerminalArg* keys
  if [[ $package == "alacritty" ]]; then
    mkdir -p ~/.local/share/applications
    cp "$HOOPOO_PATH/applications/$desktop_id" ~/.local/share/applications/
  elif [[ $package == "foot" ]]; then
    mkdir -p ~/.local/share/applications
    cp "$HOOPOO_PATH/default/foot/$desktop_id" ~/.local/share/applications/
  fi

  # Copy default config for optional terminals when missing
  if [[ ! -e ~/.config/$package ]]; then
    cp -Rpf "$HOOPOO_PATH/config/$package" ~/.config/
  fi

  hoopoo-default-terminal "$package"
else
  echo "Failed to install $package"
fi
